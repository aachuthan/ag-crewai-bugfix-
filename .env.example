# Required
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (uses LiteLLM provider prefix)
CLAUDE_MODEL=anthropic/claude-sonnet-4-6

# Claude Code SDK limits
CLAUDE_CODE_MAX_TURNS=20
CLAUDE_CODE_PERMISSION_MODE=acceptEdits

# Flow configuration
MAX_RETRY_ITERATIONS=3

# Jira integration (optional — only needed for `fix-from-jira` command)
# Get your API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# Observability (optional — traces agent reasoning and tool usage to Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
